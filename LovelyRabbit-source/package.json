{
  "name": "lovely-rabbit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 0.0.0.0",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 0.0.0.0",
